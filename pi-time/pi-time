#!/usr/bin/env bash
# pi-time: pi with the freshtime tools, in its own agent dir.
# Usage: ./pi-time/pi-time [pi args...]   (run from any directory)
set -euo pipefail
here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
export PI_CODING_AGENT_DIR="$here/agent"
export FRESHTIME_REPO="$(dirname "$here")"

# Share the user's pi login without copying it into the repo (the link is gitignored).
if [ ! -e "$PI_CODING_AGENT_DIR/auth.json" ] && [ -f "$HOME/.pi/agent/auth.json" ]; then
  ln -s "$HOME/.pi/agent/auth.json" "$PI_CODING_AGENT_DIR/auth.json"
fi
if [ ! -d "$FRESHTIME_REPO/node_modules/chrono-node" ]; then
  (cd "$FRESHTIME_REPO" && npm install --silent)
fi
exec pi "$@"
